# Database
DATABASE_URL=postgresql://cypherlink:cypherlink@localhost:5432/cypherlink

# Redis (optional — no Redis client is wired yet; presence enables health-check stub)
# REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
COOKIE_SECRET=change-me-cookie-secret

# App
FRONTEND_URL=http://localhost:5173
PORT=3001
NODE_ENV=development

# S3 / Object Storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=cypherlink-uploads
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# Upload
UPLOAD_MAX_MB=250

# Token TTLs
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
QR_CHECKIN_TOKEN_TTL=10m
CYPHER_ASSET_TTL_HOURS=24

# How long attendee personal check-in QR tokens stay valid
ATTENDEE_CHECKIN_TTL=24h

# Public base URL for file URLs returned to the client after upload.
# MinIO local: http://localhost:9000/cypherlink-uploads
# AWS S3: leave blank — auto-derived from S3_BUCKET + S3_REGION
# IMPORTANT: must be set in production — omitting it leaks the internal S3 endpoint
#            host in presigned URLs returned to users.
S3_PUBLIC_URL=http://localhost:9000/cypherlink-uploads

# QR code JWT signing secret (attendee check-in tokens)
QR_JWT_SECRET=change-me-in-production-min-32-chars

# Web Push (VAPID) — generate keys with: npx web-push generate-vapid-keys
# Leave blank to disable push notifications (in-app notifications still work)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_EMAIL=admin@cypherlink.in

# WebSocket URL consumed by the frontend (set in cypherlink-frontend/.env)
# VITE_WS_URL=http://localhost:3001
# VITE_API_URL=http://localhost:3001/api

# ── Production CSP for nginx (SPA is served separately — not by NestJS) ──────
#
# Add this header in your nginx server block for index.html:
#
#   add_header Content-Security-Policy "
#     default-src 'self';
#     script-src 'self';
#     style-src 'self' 'unsafe-inline';
#     img-src 'self' data: blob: <S3_PUBLIC_URL>;
#     media-src 'self' blob: <S3_PUBLIC_URL>;
#     connect-src 'self' <API_ORIGIN> wss://<WS_HOST>;
#     font-src 'self';
#     object-src 'none';
#     frame-src 'none';
#   " always;

