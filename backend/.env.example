# Database
DATABASE_URL=postgresql://cypherlink:cypherlink@localhost:5432/cypherlink

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
COOKIE_SECRET=change-me-cookie-secret

# App
FRONTEND_URL=http://localhost:5173
PORT=3001
NODE_ENV=development

# S3 / Object Storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=cypherlink-uploads
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# Upload
UPLOAD_MAX_MB=250

# Token TTLs
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
QR_CHECKIN_TOKEN_TTL=10m
CYPHER_ASSET_TTL_HOURS=24

# How long attendee personal check-in QR tokens stay valid
ATTENDEE_CHECKIN_TTL=24h

# Public base URL for file URLs returned to the client after upload.
# MinIO local: http://localhost:9000/cypherlink-uploads
# AWS S3: leave blank — auto-derived from S3_BUCKET + S3_REGION
S3_PUBLIC_URL=http://localhost:9000/cypherlink-uploads
