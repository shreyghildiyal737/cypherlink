# API origin — must match the running backend URL
VITE_API_URL=http://localhost:3001/api

# WebSocket origin — must match the running backend URL (no /api suffix)
VITE_WS_URL=http://localhost:3001

# Production example:
# VITE_API_URL=https://api.cypherlink.in/api
# VITE_WS_URL=https://api.cypherlink.in
